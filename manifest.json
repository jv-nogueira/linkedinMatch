{
  "manifest_version": 3,
  "name": "Match no LinkedIn",
  "description": "Filtra vagas pelas palavras-chave e gera um arquivo em TXT.",
  "version": "1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://script.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coincide a descrição"
  },
  "icons": {
    "48": "icons/automacao.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"]
    }
  ]
}